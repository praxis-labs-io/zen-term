.build/
.swiftpm/
*.xcodeproj
DerivedData/
.DS_Store

# libghostty backend (ZEN-40/ZEN-45). vendor/ghostty is a pinned submodule (the
# ghostty source); the downloaded Zig toolchain under vendor/, the built xcframework,
# and the staged runtime resources are rebuilt from source by bin/build-ghosttykit and
# never committed. See docs/libghostty-spike.md.
/vendor/*
!/vendor/ghostty
/Frameworks/GhosttyKit.xcframework/
/Sources/TerminalKit/Resources/ghostty-resources/
