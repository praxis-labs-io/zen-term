#!/usr/bin/env bash
# Build and run ZenTerm on the libghostty backend. Any args pass through
# to `swift run` (e.g. bin/run -Xswiftc -O).
set -euo pipefail
cd "$(dirname "$0")/.."

# Keep Spotlight out of the build tree; see the same line in bin/check for why.
mkdir -p .build 2>/dev/null && touch .build/.metadata_never_index 2>/dev/null || true

# The GhosttyKit binaryTarget is linked unconditionally and its runtime resources are
# a declared SwiftPM resource, so both must exist to build either backend. They're
# gitignored — bin/build-ghosttykit produces both in one run.
if [[ ! -d Frameworks/GhosttyKit.xcframework ]] \
    || [[ ! -d Sources/TerminalKit/Resources/ghostty-resources ]]; then
    echo "✗ GhosttyKit artifacts missing — build them first: bin/build-ghosttykit" >&2
    exit 1
fi

# Filter the harmless linker noise so real app logs stand out: the prebuilt CodeEditLanguages
# xcframework carries debug info pointing at its maintainer's build paths ("unable to
# open object file /Users/Khan/…"), and libghostty-fat.a has a couple of "could not find symbol …
# in object file" lines. Neither is a real problem, and `-Xlinker -w` doesn't suppress them on the
# current linker. The `> >(…) 2>&1` process substitution filters both streams while `exec` keeps
# the app's exit code, signals, and debug symbols intact.
LINKER_NOISE='unable to open object file|could not find symbol .* in object file'
exec swift run ZenTerm "$@" > >(grep --line-buffered -vE "$LINKER_NOISE") 2>&1
