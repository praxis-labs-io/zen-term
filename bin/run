#!/usr/bin/env bash
# Build and run ZenTerm. Default backend is SwiftTerm; pass --ghostty to run the
# libghostty backend (ZENTERM_BACKEND=ghostty, ZEN-40 spike). Any further args pass
# through to `swift run` (e.g. bin/run --ghostty -Xswiftc -O).
set -euo pipefail
cd "$(dirname "$0")/.."

# The GhosttyKit binaryTarget is linked unconditionally and its runtime resources are
# a declared SwiftPM resource, so both must exist to build either backend. They're
# gitignored — bin/build-ghosttykit produces both in one run.
if [[ ! -d Frameworks/GhosttyKit.xcframework ]] \
    || [[ ! -d Sources/TerminalKit/Resources/ghostty-resources ]]; then
    echo "✗ GhosttyKit artifacts missing — build them first: bin/build-ghosttykit" >&2
    exit 1
fi

if [[ "${1:-}" == "--ghostty" ]]; then
    shift
    exec env ZENTERM_BACKEND=ghostty swift run ZenTerm "$@"
fi

exec swift run ZenTerm "$@"
