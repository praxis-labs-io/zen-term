#!/usr/bin/env bash
# Local mirror of CI: build → test → format-lint → lint. Run before shipping.
# Pass --fix to auto-apply swift-format + swiftlint fixes instead of failing.
set -euo pipefail
cd "$(dirname "$0")/.."

# Harmless linker noise from the prebuilt CodeEditLanguages xcframework (debug info pointing at its
# maintainer's build paths) and libghostty-fat.a — filtered out so real output stands out.
# `-Xlinker -w` doesn't suppress these on the current linker.
#
# Filtered through a pipeline, not a `> >(…)` process substitution: bash doesn't wait on a
# substituted process, so a failing build could exit under `set -e` before the filter flushed the
# diagnostics explaining the failure. A pipeline waits. `set -o pipefail` (above) is what keeps the
# compiler's exit status rather than the filter's; `|| true` only neutralises grep's "matched
# nothing" 1 so it can't fail an otherwise-clean run.
LINKER_NOISE='unable to open object file|could not find symbol .* in object file'
filter_noise() { grep --line-buffered -vE "$LINKER_NOISE" || true; }

if ! command -v swiftlint >/dev/null 2>&1; then
    echo "✗ swiftlint not found — install it with: brew install swiftlint" >&2
    exit 1
fi

if [[ "${1:-}" == "--fix" ]]; then
    echo "▸ swift format (in place)"
    swift format --in-place --recursive Sources Tests
    echo "▸ swiftlint --fix"
    swiftlint lint --fix --quiet Sources Tests
    echo "✓ fixes applied — re-run bin/check to verify"
    exit 0
fi

echo "▸ swift build"
swift build 2>&1 | filter_noise

echo "▸ swift test"
swift test 2>&1 | filter_noise

echo "▸ swift format lint"
swift format lint --strict --recursive Sources Tests

echo "▸ swiftlint"
swiftlint lint --strict --quiet Sources Tests

echo "✓ all checks passed"
