#!/usr/bin/env bash
# Cut a signed, notarized public ZenTerm release.
# Usage: bin/release [X.Y.Z | major | minor | patch] [--notes-file FILE] [--skip-checks]
#   (no version)  patch-bump the last release tag; 0.1.0 if there are no tags yet
#   major|minor|patch  bump that component of the last release tag
#   X.Y.Z         release exactly this version
#   --notes-file  release notes markdown (default: curated git-log scaffold in $EDITOR)
#   --skip-checks skip the bin/check gate
#
# One-time setup (see docs/releasing.md): Developer ID Application cert in the
# keychain, `xcrun notarytool store-credentials zenterm-notary`, and the Sparkle
# EdDSA key imported, not generated. Safe to rerun after a partial failure with the same
# version: tagging, notes curation, and release creation each detect and reuse
# the prior run's state.
set -euo pipefail
INVOKER_PWD="$PWD"
cd "$(dirname "$0")/.."

NOTARY_PROFILE="zenterm-notary"
RELEASES_REPO="praxis-labs-io/zen-term"
DIST="dist"

USAGE="usage: bin/release [X.Y.Z | major | minor | patch] [--notes-file FILE] [--skip-checks]"
SEMVER_RE='^[0-9]+\.[0-9]+\.[0-9]+$'
# Only vX.Y.Z is a release. Any other tag reachable from HEAD (a checkpoint, a
# vendor pin) must not reach the bump arithmetic below.
RELEASE_TAG_GLOB='v[0-9]*.[0-9]*.[0-9]*'
VERSION=""
BUMP=""
if [[ $# -gt 0 && "$1" != -* ]]; then
    case "$1" in
        major | minor | patch) BUMP="$1" ;;
        *)
            [[ "$1" =~ $SEMVER_RE ]] || { echo "$USAGE" >&2; exit 1; }
            VERSION="$1" ;;
    esac
    shift
fi

NOTES_FILE=""
SKIP_CHECKS=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --notes-file)
            [[ $# -ge 2 && "$2" != -* ]] || { echo "✗ missing value for --notes-file" >&2; exit 1; }
            NOTES_FILE="$2"; shift 2 ;;
        --skip-checks) SKIP_CHECKS=1; shift ;;
        *) echo "unknown argument: $1" >&2; exit 1 ;;
    esac
done

APP="$DIST/ZenTerm.app"

echo "▸ Preflight"
[[ -z "$(git status --porcelain)" ]] || { echo "✗ working tree not clean" >&2; exit 1; }
[[ "$(git rev-parse --abbrev-ref HEAD)" == "main" ]] || { echo "✗ not on main" >&2; exit 1; }
git fetch origin main --quiet
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] \
    || { echo "✗ local main is not in sync with origin/main" >&2; exit 1; }

# Tags drive the version resolution below, so a stale local tag set (a shallow
# clone, a release cut from another checkout) would resolve behind what's already
# published and ship backwards. Fetching them can legitimately fail: a local tag
# pointing somewhere origin disagrees with is a real conflict, and git reports it
# as "would clobber existing tag". Catch it, because under `set -e` an unhandled
# non-zero here kills the run with no explanation at all.
git fetch origin --tags --quiet || {
    echo "✗ couldn't fetch tags: a local tag disagrees with origin" >&2
    echo "  reconcile before releasing, e.g. git tag -d <tag> && git fetch origin --tags" >&2
    exit 1
}

LAST_TAG="$(git describe --tags --abbrev=0 --match "$RELEASE_TAG_GLOB" 2>/dev/null || true)"

if [[ -z "$VERSION" ]]; then
    if [[ -z "$LAST_TAG" ]]; then
        # Bumping needs something to bump. Guessing here would burn a permanent
        # version on a first release, so make the user say what they mean.
        [[ -z "$BUMP" ]] || {
            echo "✗ no release tags yet, so there is nothing to $BUMP-bump" >&2
            echo "  run bare 'bin/release' to seed 0.1.0, or name a version" >&2
            exit 1
        }
        VERSION="0.1.0"
        echo "▸ No release tags yet, seeding $VERSION"
    elif [[ "$(git rev-parse "$LAST_TAG^{commit}")" == "$(git rev-parse HEAD)" ]]; then
        # The last tag already points at HEAD, so this is a rerun of an interrupted
        # release rather than a new one. Bumping here would strand that tag and its
        # half-published release; reusing the version lets the resume paths below
        # (tag / notes / release reuse) find the prior run's state.
        VERSION="${LAST_TAG#v}"
        echo "▸ $LAST_TAG is already on HEAD, resuming that release"
    else
        IFS=. read -r MAJOR MINOR PATCH <<< "${LAST_TAG#v}"
        case "${BUMP:-patch}" in
            major) VERSION="$((MAJOR + 1)).0.0" ;;
            minor) VERSION="${MAJOR}.$((MINOR + 1)).0" ;;
            patch) VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))" ;;
        esac
        echo "▸ ${BUMP:-patch} bump from $LAST_TAG → v$VERSION"
    fi
fi

# Whatever produced it (bump arithmetic, a resumed tag, the CLI), this string is
# about to become a permanent public tag. Check it once, here, where every path
# converges.
[[ "$VERSION" =~ $SEMVER_RE ]] || { echo "✗ resolved version '$VERSION' is not X.Y.Z" >&2; exit 1; }

# A published version can never be reused or walked back, so refuse to descend
# even when the user named the version by hand. Resuming the tag at HEAD is the
# one legitimate non-ascending case, and it's equal rather than lower.
if [[ -n "$LAST_TAG" && "$VERSION" != "${LAST_TAG#v}" ]]; then
    [[ "$(printf '%s\n%s\n' "${LAST_TAG#v}" "$VERSION" | sort -V | head -1)" == "${LAST_TAG#v}" ]] \
        || { echo "✗ $VERSION is not above the last release $LAST_TAG" >&2; exit 1; }
fi

TAG="v$VERSION"
DMG="$DIST/ZenTerm-$VERSION-arm64.dmg"

if [[ -n "$NOTES_FILE" ]]; then
    # The script cd'd to the repo root; resolve a relative path against the
    # directory the user invoked from, not the repo root.
    [[ "$NOTES_FILE" == /* ]] || NOTES_FILE="$INVOKER_PWD/$NOTES_FILE"
    [[ -f "$NOTES_FILE" ]] || { echo "✗ notes file not found: $NOTES_FILE" >&2; exit 1; }
else
    [[ -t 0 ]] || { echo "✗ no TTY for the \$EDITOR notes pass: pass --notes-file" >&2; exit 1; }
fi

# A tag may exist from a failed prior run of this same release; that's fine as
# long as it points at HEAD, locally and on origin. Anything else is a
# version collision.
TAG_AT_HEAD=0
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
    [[ "$(git rev-parse "$TAG^{commit}")" == "$(git rev-parse HEAD)" ]] \
        || { echo "✗ tag $TAG exists locally and does not point at HEAD" >&2; exit 1; }
    TAG_AT_HEAD=1
fi
REMOTE_TAG_SHA="$(git ls-remote --tags origin "$TAG^{}" "$TAG" | awk 'END {print $1}')"
if [[ -n "$REMOTE_TAG_SHA" && "$REMOTE_TAG_SHA" != "$(git rev-parse HEAD)" ]]; then
    echo "✗ tag $TAG exists on origin and does not point at HEAD" >&2
    exit 1
fi

gh auth status >/dev/null || { echo "✗ gh not authenticated" >&2; exit 1; }
gh repo view "$RELEASES_REPO" >/dev/null || { echo "✗ can't reach $RELEASES_REPO" >&2; exit 1; }

# Distinguish "release absent" (proceed), "release exists without our DMG"
# (partial prior run: upload into it), and "release exists with the DMG"
# (already shipped), without letting a transient gh failure pass as absent.
RELEASE_EXISTS=0
set +e
RELEASE_ASSETS="$(gh release view "$TAG" --repo "$RELEASES_REPO" --json assets --jq '.assets[].name' 2>&1)"
RELEASE_VIEW_RC=$?
set -e
if [[ "$RELEASE_VIEW_RC" -eq 0 ]]; then
    if grep -qx "$(basename "$DMG")" <<< "$RELEASE_ASSETS"; then
        echo "✗ release $TAG already shipped on $RELEASES_REPO with $(basename "$DMG")" >&2
        exit 1
    fi
    RELEASE_EXISTS=1
elif ! grep -qi "release not found" <<< "$RELEASE_ASSETS"; then
    echo "✗ couldn't query releases on $RELEASES_REPO: $RELEASE_ASSETS" >&2
    exit 1
fi

IDENTITY="$(security find-identity -v -p codesigning | awk -F'"' '/Developer ID Application/{print $2; exit}')"
[[ -n "$IDENTITY" ]] || {
    echo "✗ no 'Developer ID Application' identity in the keychain (see CLAUDE.md → Releasing)" >&2
    exit 1
}

xcrun --find notarytool >/dev/null && xcrun --find stapler >/dev/null \
    || { echo "✗ notarytool/stapler missing: full Xcode required, not just CLT" >&2; exit 1; }
xcrun notarytool history --keychain-profile "$NOTARY_PROFILE" >/dev/null \
    || { echo "✗ notary profile '$NOTARY_PROFILE' missing or invalid (see CLAUDE.md → Releasing)" >&2; exit 1; }

# Sparkle's EdDSA signing key. Resolve the pinned Sparkle artifact so sign_update exists,
# then prove the private key is reachable in the keychain: a missing key must fail here, beside the
# other credential checks, not after the multi-minute notarize waits. One-time setup: `generate_keys`.
swift package resolve >/dev/null 2>&1 || true
SIGN_UPDATE="$(find .build/artifacts -type f -name sign_update 2>/dev/null | head -1)"
[[ -n "$SIGN_UPDATE" ]] \
    || { echo "✗ sign_update not found: 'swift package resolve' should fetch the Sparkle artifact" >&2; exit 1; }
SIGN_PROBE="$(mktemp)"
"$SIGN_UPDATE" "$SIGN_PROBE" >/dev/null 2>&1 \
    || { echo "✗ sign_update can't reach the Sparkle EdDSA key: run generate_keys (see CLAUDE.md → Releasing)" >&2; rm -f "$SIGN_PROBE"; exit 1; }
rm -f "$SIGN_PROBE"

[[ -d Frameworks/GhosttyKit.xcframework ]] \
    || { echo "✗ GhosttyKit.xcframework missing: run bin/build-ghosttykit" >&2; exit 1; }

# The DMG window is styled by bin/make-dmg, which needs the committed background art and a
# terminal authorized to control Finder. Both are checked here, up front, so a missing asset
# or a denied Automation prompt fails preflight rather than after the multi-minute notarize.
[[ -s icon/dmg-background.tiff ]] \
    || { echo "✗ icon/dmg-background.tiff missing: regenerate with icon/make-dmg-background.sh" >&2; exit 1; }
osascript -e 'tell application "Finder" to get version' >/dev/null 2>&1 \
    || { echo "✗ terminal not authorized to control Finder (needed to style the DMG): grant it in System Settings > Privacy & Security > Automation" >&2; exit 1; }

if [[ "$SKIP_CHECKS" -eq 0 ]]; then
    echo "▸ Gate: bin/check"
    bin/check
fi

# Notes are curated BEFORE the multi-minute notarization waits, and a prior
# partial run's curated notes are reused rather than wiped. The filename carries
# the version: an abandoned 0.2.0 run must not hand its feature notes to a later
# 0.1.1, which is what a shared notes.md did.
mkdir -p "$DIST"
# The signed app assembled here shares com.drucial.ZenTerm with the installed
# release. Spotlight indexes dist/, and Raycast discovers apps through that index,
# so the build artifact would surface beside (or instead of) the /Applications
# release. This marker keeps dist/ out of Spotlight's index. (LaunchServices
# registration on launch is a separate subsystem this marker does not govern; the
# dist/ artifacts are transient and cleaned by the next bin/release run.)
touch "$DIST/.metadata_never_index"
if [[ -z "$NOTES_FILE" ]]; then
    NOTES_FILE="$DIST/notes-$VERSION.md"
    if [[ ! -s "$NOTES_FILE" ]]; then
        PREV="$(git describe --tags --abbrev=0 --match "$RELEASE_TAG_GLOB" --exclude "$TAG" 2>/dev/null || true)"
        git log ${PREV:+"$PREV.."}HEAD --pretty='- %s' > "$NOTES_FILE"
    fi
    # Curate before publishing: private-repo commit subjects go public here.
    # sh -c so multi-word editors ("code --wait") work.
    sh -c "${EDITOR:-vi} \"\$1\"" sh "$NOTES_FILE"
fi

# The update card's bullets. The card wants a short list, not the whole notes file, which
# also carries the Install / Reporting boilerplate. A `<!-- card ... -->` block lets the notes read
# as pure prose on the GitHub release page (HTML comments don't render there) while handing the card
# an explicit list; a file predating the convention (e.g. the bare git-log scaffold, all bullets)
# falls back to its top-level "- "/"* " lines. ZenUpdateDriver.bullets(from:) strips and caps these
# downstream; here we gather them and refuse to publish an empty set, since an empty <description>
# renders a blank card, which is how five releases shipped a card with no notes.
CARD_NOTES="$(awk '
    /<!--[[:space:]]*card/ { in_card=1; next }
    in_card && /-->/       { in_card=0; next }
    in_card                { print }
' "$NOTES_FILE")"
BULLET_RE='^[[:space:]]*[-*][[:space:]]'
if ! grep -qE "$BULLET_RE" <<< "$CARD_NOTES"; then
    CARD_NOTES="$(grep -E "$BULLET_RE" "$NOTES_FILE" || true)"
fi
grep -qE "$BULLET_RE" <<< "$CARD_NOTES" \
    || { echo "✗ no update-card bullets in $NOTES_FILE: add a '<!-- card ... -->' list (the in-app update card shows these; without them it renders blank)" >&2; exit 1; }

rm -rf "$APP" "$DIST/ZenTerm.zip" "$DIST/dmg-root" "$DMG"
bin/package-app --version "$VERSION" --identity "$IDENTITY" --dest "$DIST" --variant release

echo "▸ Notarizing app"
ditto -c -k --keepParent "$APP" "$DIST/ZenTerm.zip"
xcrun notarytool submit "$DIST/ZenTerm.zip" --keychain-profile "$NOTARY_PROFILE" --wait \
    || { echo "✗ notarization failed; inspect with: xcrun notarytool log <id> --keychain-profile $NOTARY_PROFILE" >&2; exit 1; }
xcrun stapler staple "$APP"

echo "▸ Building DMG"
bin/make-dmg --app "$APP" --version "$VERSION" --dest "$DIST"
codesign --force --timestamp --sign "$IDENTITY" "$DMG"

echo "▸ Notarizing DMG"
xcrun notarytool submit "$DMG" --keychain-profile "$NOTARY_PROFILE" --wait \
    || { echo "✗ notarization failed; inspect with: xcrun notarytool log <id> --keychain-profile $NOTARY_PROFILE" >&2; exit 1; }
xcrun stapler staple "$DMG"

echo "▸ Verifying"
codesign --verify --strict --deep --verbose=2 "$APP"
spctl -a -t exec -vv "$APP"
xcrun stapler validate "$APP"
spctl -a -t open --context context:primary-signature -vv "$DMG"
xcrun stapler validate "$DMG"

# Appcast. The EdDSA signature is taken here, on the final DMG: `stapler staple` above
# rewrote its bytes, so a signature taken any earlier wouldn't match what users download. The
# sparkle:version is read back out of the built app's plist rather than recomputing the commit
# count: two places deriving one number is how they drift. The card bullets (CARD_NOTES, gathered
# above) go into the description CDATA; the full curated prose stays in the GitHub release body, which
# releaseNotesLink points at as the card's "What's new".
echo "▸ Appcast"
BUILD="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$APP/Contents/Info.plist")"
ED_ATTRS="$("$SIGN_UPDATE" "$DMG")"  # sparkle:edSignature="…" length="…"
APPCAST="$DIST/appcast.xml"
DMG_NAME="$(basename "$DMG")"
PUBDATE="$(date -u '+%a, %d %b %Y %H:%M:%S +0000')"
cat > "$APPCAST" <<XML
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>ZenTerm</title>
    <item>
      <title>ZenTerm $VERSION</title>
      <pubDate>$PUBDATE</pubDate>
      <sparkle:version>$BUILD</sparkle:version>
      <sparkle:shortVersionString>$VERSION</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <sparkle:releaseNotesLink>https://github.com/$RELEASES_REPO/releases/tag/$TAG</sparkle:releaseNotesLink>
      <description><![CDATA[
$CARD_NOTES
]]></description>
      <enclosure url="https://github.com/$RELEASES_REPO/releases/latest/download/$DMG_NAME" $ED_ATTRS type="application/octet-stream" />
    </item>
  </channel>
</rss>
XML

echo "▸ Tagging + publishing"
if [[ "$TAG_AT_HEAD" -eq 0 ]]; then
    git tag -a "$TAG" -m "ZenTerm $TAG"
fi
if [[ -z "$REMOTE_TAG_SHA" ]]; then
    git push origin "$TAG"
fi
# The appcast rides alongside the DMG so `latest/download/appcast.xml` (SUFeedURL) resolves for
# already-installed copies checking in.
if [[ "$RELEASE_EXISTS" -eq 1 ]]; then
    gh release upload "$TAG" --repo "$RELEASES_REPO" --clobber "$DMG" "$APPCAST"
else
    gh release create "$TAG" --repo "$RELEASES_REPO" \
        --title "ZenTerm $VERSION" --notes-file "$NOTES_FILE" "$DMG" "$APPCAST"
fi

echo "✓ ZenTerm $VERSION released: https://github.com/$RELEASES_REPO/releases/tag/$TAG"
