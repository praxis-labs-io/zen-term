#!/usr/bin/env bash
# Build GhosttyKit.xcframework from source for the libghostty backend (the default).
#
# libghostty ships no prebuilt embeddable artifact — the released Ghostty.app statically
# links it into its main binary. So we build it ourselves: pin the ghostty source, drive
# its Zig build to emit the macOS xcframework, and drop it where Package.swift's
# GhosttyKit binaryTarget expects it. The result (Frameworks/GhosttyKit.xcframework) is
# gitignored; every machine rebuilds it once with this script.
#
# Prereqs it can't install for you:
#   • Xcode (full) selected: xcode-select -p → /Applications/Xcode.app/...
#   • Metal toolchain: xcodebuild -downloadComponent MetalToolchain
# The ghostty source is the pinned vendor/ghostty submodule (v1.3.1); Zig 0.15.2 is
# fetched on demand. The submodule is auto-initialized below if not yet checked out.
set -euo pipefail

ZIG_VERSION="0.15.2"       # ghostty v1.3.1's minimum_zig_version
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENDOR="$ROOT/vendor"
ZIG_DIR="$VENDOR/zig-aarch64-macos-$ZIG_VERSION"
ZIG="$ZIG_DIR/zig"
GHOSTTY="$VENDOR/ghostty"

mkdir -p "$VENDOR"

# 1. Zig 0.15.2 — Homebrew tracks a newer Zig whose stdlib won't compile v1.3.1, so we
#    fetch the exact toolchain locally rather than install it system-wide.
if [ ! -x "$ZIG" ]; then
  echo "▸ fetching Zig $ZIG_VERSION"
  curl -sSL "https://ziglang.org/download/$ZIG_VERSION/zig-aarch64-macos-$ZIG_VERSION.tar.xz" \
    -o "$VENDOR/zig.tar.xz"
  tar xf "$VENDOR/zig.tar.xz" -C "$VENDOR"
  rm -f "$VENDOR/zig.tar.xz"
fi

# 2. ghostty source, from the pinned vendor/ghostty submodule. Auto-init on a fresh
#    checkout so the script works end to end without a manual submodule step.
if [ ! -f "$GHOSTTY/build.zig" ]; then
  echo "▸ initializing ghostty submodule"
  git -C "$ROOT" submodule update --init vendor/ghostty
fi

# 3. Build the native (arm64-only) xcframework. app-runtime=none selects libghostty;
#    emit-macos-app=false skips the full app (which would need xcodebuild + signing).
#    i18n=false compiles out ghostty's gettext call sites so nothing references the LGPL
#    libintl ghostty bundles on Apple platforms (Apple libc omits it). SharedDeps.zig still
#    links it, but the release linker then dead-strips the now-unreferenced archive, so it
#    leaves the shipped binary and the app stays clear of LGPL static-linking obligations. bin/package-app probes the linked binary to enforce that it dropped. One
#    behavior tradeoff (not zero): it also disables ghostty's macOS locale canonicalization,
#    so a non-English macOS user's child shell gets a non-canonical LANGUAGE (LANG is
#    unaffected). We ship no translations, so app-side copy is unchanged. See
#    docs/third-party-notices.md.
echo "▸ building GhosttyKit.xcframework (this takes a few minutes)"
( cd "$GHOSTTY" && "$ZIG" build \
    -Dapp-runtime=none \
    -Demit-macos-app=false \
    -Dxcframework-target=native \
    -Di18n=false \
    -Doptimize=ReleaseFast )

# 4. Stage it where Package.swift's binaryTarget points.
echo "▸ staging Frameworks/GhosttyKit.xcframework"
rm -rf "$ROOT/Frameworks/GhosttyKit.xcframework"
mkdir -p "$ROOT/Frameworks"
cp -R "$GHOSTTY/macos/GhosttyKit.xcframework" "$ROOT/Frameworks/"

# 5. Stage libghostty's runtime resources (shell-integration, themes, terminfo) from the
#    same build, as a TerminalKit SwiftPM resource so Bundle.module resolves them at
#    runtime. The ghostty/ + terminfo/ sibling layout mirrors Ghostty.app's
#    Resources/{ghostty,terminfo} pair — libghostty derives TERMINFO from the sibling of
#    GHOSTTY_RESOURCES_DIR. Gitignored, like the xcframework: version-matched to the pin.
echo "▸ staging Sources/TerminalKit/Resources/ghostty-resources"
RES="$ROOT/Sources/TerminalKit/Resources/ghostty-resources"
rm -rf "$RES"
mkdir -p "$RES"
cp -R "$GHOSTTY/zig-out/share/ghostty" "$RES/ghostty"
cp -R "$GHOSTTY/zig-out/share/terminfo" "$RES/terminfo"

echo "✓ done — build with: swift build; run with: swift run ZenTerm"
