#!/usr/bin/env bash
# Package ZenTerm as a standalone .app.
# Usage: bin/package-app [--version X.Y.Z] [--identity "NAME"] [--dest DIR] [--variant dev|release]
#   --version   CFBundleShortVersionString (default: latest tag + "+<commits since>")
#   --identity  codesign identity (default "-" = ad-hoc, for daily driving)
#   --dest      output directory (default ~/Applications)
#   --variant   dev (default): "ZenTerm Dev", com.drucial.ZenTerm.dev, dev icon, no Sparkle feed.
#               release: "ZenTerm", com.drucial.ZenTerm, release icon, public Sparkle feed.
set -euo pipefail
cd "$(dirname "$0")/.."

VERSION=""
IDENTITY="-"
DEST="$HOME/Applications"
VARIANT="dev"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --version | --identity | --dest | --variant)
            [[ $# -ge 2 ]] || { echo "✗ missing value for $1" >&2; exit 1; }
            case "$1" in
                --version) VERSION="$2" ;;
                --identity) IDENTITY="$2" ;;
                --dest) DEST="$2" ;;
                --variant) VARIANT="$2" ;;
            esac
            shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 1 ;;
    esac
done

case "$VARIANT" in
    dev)
        BUNDLE_NAME="ZenTerm Dev"
        BUNDLE_ID="com.drucial.ZenTerm.dev"
        ICON_SRC="icon/AppIcon-Dev.icns"
        APP_BASENAME="ZenTerm Dev.app"
        ;;
    release)
        BUNDLE_NAME="ZenTerm"
        BUNDLE_ID="com.drucial.ZenTerm"
        ICON_SRC="icon/AppIcon.icns"
        APP_BASENAME="ZenTerm.app"
        ;;
    *) echo "✗ unknown variant: $VARIANT (want dev|release)" >&2; exit 1 ;;
esac

if [[ -z "$VERSION" ]]; then
    # A daily driver names the release it descends from: "0.1.0+7" is seven commits
    # past v0.1.0. The bare "-dev" this replaced was identical on every build
    # between two releases, so a dogfood bug report couldn't name one.
    # Match only vX.Y.Z: an unfiltered describe would hand a checkpoint or vendor
    # tag to the stamp and the footer would read "vcheckpoint+3".
    LAST_TAG="$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"
    if [[ -n "$LAST_TAG" ]]; then
        AHEAD="$(git rev-list --count "${LAST_TAG}..HEAD" 2>/dev/null || echo 0)"
        VERSION="${LAST_TAG#v}+${AHEAD}"
    else
        VERSION="0.0.0+$(git rev-list --count HEAD 2>/dev/null || echo 0)"
    fi
fi
# Monotonic build number (commit count on the current branch): unique per release
# commit and Sparkle-compatible, unlike a short SHA. Deliberately NOT the "+N"
# above, which resets to 0 at every tag and so would go backwards for Sparkle.
BUILD="$(git rev-list --count HEAD 2>/dev/null || echo 0)"

APP="$DEST/$APP_BASENAME"
BIN=".build/release/ZenTerm"

# SwiftPM resource bundles (brand SVGs, ghostty runtime resources). They ride in
# Contents/Resources, which is Bundle.main.resourceURL at runtime: the location
# `Bundle.zenResourceBundle` looks in first. (The SwiftPM-generated Bundle.module
# accessor for a statically-linked executable target instead looks at the .app
# *root* plus a build-machine-absolute .build path; codesign refuses loose content
# at the root, so the bundles cannot live where that accessor expects. See
# Bundle+ZenResource.swift: that resolver is why these belong in Contents/Resources.)
#
# A `*.bundle` glob over .build/release once signed, notarized and published a dead
# SwiftTerm bundle to users in v0.1.0, long after libghostty became the sole backend
# (ZEN-168): `swift build` never prunes .build, so a dropped dependency leaves its
# bundle there forever and the glob swept it into the app. Clearing the bundles
# first is what makes that impossible rather than merely detected. The build
# re-emits exactly the set Package.swift declares, so the app follows the manifest
# instead of whatever this machine happens to have built. Cheap: re-emitting a
# bundle is a resource copy, not a relink.
EXPECTED_BUNDLES=(ZenTerm_TerminalKit.bundle ZenTerm_ZenTerm.bundle)

echo "▸ Building release…"
rm -rf .build/release/*.bundle
swift build -c release

# The bundle set is asserted both ways. After the wipe these describe the manifest,
# not residue: a missing bundle means the build didn't emit one we ship (a partial
# app would fatalError on first Bundle.module access), and an unexpected bundle
# means Package.swift grew one nobody told this script about.
for bundle in "${EXPECTED_BUNDLES[@]}"; do
    [[ -d ".build/release/$bundle" ]] || {
        echo "✗ expected resource bundle missing: .build/release/$bundle" >&2
        echo "  a partial app would fatalError on first Bundle.module access" >&2
        exit 1
    }
done

for path in .build/release/*.bundle; do
    found="$(basename "$path")"
    for expected in "${EXPECTED_BUNDLES[@]}"; do
        [[ "$found" == "$expected" ]] && continue 2
    done
    echo "✗ Package.swift emits a resource bundle this script doesn't ship: $found" >&2
    echo "  add it to EXPECTED_BUNDLES" >&2
    exit 1
done

# ZEN-170: refuse to ship GNU libintl (LGPL-2.1). bin/build-ghosttykit builds ghostty with
# -Di18n=false so nothing references the libintl it bundles on Apple platforms and the release
# linker dead-strips it, but that is a property of the staged GhosttyKit: an xcframework built
# before that flag, or a ghostty pin that force-loads the intl archive, would relink libintl
# while THIRD-PARTY-NOTICES.md no longer discloses it. Probing the linked binary here is the
# gate a stale artifact cannot pass. Symbols like _libintl_*, _bindtextdomain, __nl_msg_cat_cntr.
if nm "$BIN" 2>/dev/null | grep -qiE 'libintl|bindtextdomain|nl_msg_cat_cntr'; then
    echo "✗ $BIN statically links GNU libintl (LGPL-2.1), not shippable in a closed-source app" >&2
    echo "  rebuild GhosttyKit with bin/build-ghosttykit (it passes -Di18n=false), then re-probe" >&2
    echo "  per docs/runbooks/third-party-notices.md" >&2
    exit 1
fi

# Assembled and signed off to the side, then swapped in at the end. $APP defaults
# to the installed daily driver, so building in place means any failure between the
# delete and the signature (a missing icon, an expired cert) leaves an unlaunchable
# shell where a working terminal used to be. Staging keeps the installed app whole
# until there is a complete signed one to replace it with. Same directory, so the
# swap is a rename rather than a copy.
echo "▸ Assembling $APP"
STAGE="$DEST/.$APP_BASENAME.partial"
rm -rf "$STAGE"
mkdir -p "$STAGE/Contents/MacOS" "$STAGE/Contents/Resources"
cp "$BIN" "$STAGE/Contents/MacOS/ZenTerm"
cp "$ICON_SRC" "$STAGE/Contents/Resources/AppIcon.icns"

# Third-party license notices (ZEN-167). The file is a SwiftPM resource, so it already rides
# inside ZenTerm_ZenTerm.bundle and the app menu opens it from there. This second copy sits at
# the top of Contents/Resources so the license file is plainly visible to anyone inspecting the
# app, which is the form several of these licenses (FTL, BSD-2, libpng, OFL, ISC) ask for.
NOTICES="Sources/ZenTerm/Resources/THIRD-PARTY-NOTICES.md"
[[ -f "$NOTICES" ]] || {
    echo "✗ $NOTICES is missing" >&2
    echo "  it is a license obligation, not an optional file (see ZEN-167)" >&2
    exit 1
}
cp "$NOTICES" "$STAGE/Contents/Resources/THIRD-PARTY-NOTICES.md"

for bundle in "${EXPECTED_BUNDLES[@]}"; do
    cp -R ".build/release/$bundle" "$STAGE/Contents/Resources/"
done

# Sparkle.framework (ZEN-118). `swift build` links it but doesn't embed it, so it rides here under
# Contents/Frameworks: the binary's @executable_path/../Frameworks rpath resolves it at launch.
# ditto (not cp -R) so the framework's Versions symlink structure stays intact, which codesign
# requires. The Downloader/Installer XPC services are only used by sandboxed apps; ZenTerm isn't
# sandboxed and doesn't set SUEnableInstallerLauncher, so drop them rather than sign + notarize dead
# code (both the real dir and its top-level symlink, or the symlink would dangle).
FRAMEWORK=".build/release/Sparkle.framework"
[[ -d "$FRAMEWORK" ]] || {
    echo "✗ $FRAMEWORK missing: swift build -c release should have emitted it beside the binary" >&2
    exit 1
}
mkdir -p "$STAGE/Contents/Frameworks"
ditto "$FRAMEWORK" "$STAGE/Contents/Frameworks/Sparkle.framework"
SPARKLE="$STAGE/Contents/Frameworks/Sparkle.framework"
rm -rf "$SPARKLE/Versions/B/XPCServices" "$SPARKLE/XPCServices"

# Dev omits every Sparkle key: with no feed the updater never checks, which is
# correct. A dev build is replaced by re-running this script, not by an update.
# The framework is still embedded and signed below; only the feed config differs.
SPARKLE_KEYS=""
if [[ "$VARIANT" == "release" ]]; then
    SPARKLE_KEYS='  <key>SUFeedURL</key><string>https://github.com/zen-term/zen-term-releases/releases/latest/download/appcast.xml</string>
  <key>SUPublicEDKey</key><string>M0c0MPZrd8TSeoMNjZi+sNBpEi7t5nYnB6t41Bsm/TU=</string>
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUScheduledCheckInterval</key><integer>86400</integer>'
fi

cat > "$STAGE/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>${BUNDLE_NAME}</string>
  <key>CFBundleDisplayName</key><string>${BUNDLE_NAME}</string>
  <key>CFBundleExecutable</key><string>ZenTerm</string>
  <key>CFBundleIdentifier</key><string>${BUNDLE_ID}</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleIconName</key><string>AppIcon</string>
  <key>CFBundleShortVersionString</key><string>${VERSION}</string>
  <key>CFBundleVersion</key><string>${BUILD}</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
${SPARKLE_KEYS}
</dict>
</plist>
PLIST

# Sign inside-out: the embedded Sparkle.framework (ZEN-118) is the first nested code this app has
# carried, so its helper tool, updater app, and the framework itself must each be signed before the
# outer app: the outer signature seals them, and bin/release's `codesign --verify --strict --deep`
# now genuinely exercises all of it. GhosttyKit stays a static library linked into the executable,
# and the SwiftPM .bundles are code-free resources sealed by the outer signature. Hardened runtime +
# secure timestamp only on the Developer ID path; ad-hoc gets neither (it can't timestamp) but still
# must sign the nested Mach-O, or the daily-driver build won't launch on arm64.
SIGN=(codesign --force --sign "$IDENTITY")
if [[ "$IDENTITY" == "-" ]]; then
    echo "▸ Ad-hoc signing (nested Sparkle + app)"
else
    echo "▸ Signing with hardened runtime: $IDENTITY"
    SIGN+=(--options runtime --timestamp)
fi
"${SIGN[@]}" "$SPARKLE/Versions/B/Autoupdate"
"${SIGN[@]}" "$SPARKLE/Versions/B/Updater.app"
"${SIGN[@]}" "$SPARKLE"
"${SIGN[@]}" "$STAGE"

# The only point where the installed app is at risk, and by now the replacement is
# complete and signed.
rm -rf "$APP"
mv "$STAGE" "$APP"

echo "✓ $APP  (v${VERSION} build ${BUILD})"
