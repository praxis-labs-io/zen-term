#!/usr/bin/env bash
# Package ZenTerm as a standalone .app.
# Usage: bin/package-app [--version X.Y.Z] [--identity "NAME"] [--dest DIR]
#   --version   CFBundleShortVersionString (default: latest tag + "+<commits since>")
#   --identity  codesign identity (default "-" = ad-hoc, for daily driving)
#   --dest      output directory (default ~/Applications)
set -euo pipefail
cd "$(dirname "$0")/.."

VERSION=""
IDENTITY="-"
DEST="$HOME/Applications"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --version | --identity | --dest)
            [[ $# -ge 2 ]] || { echo "✗ missing value for $1" >&2; exit 1; }
            case "$1" in
                --version) VERSION="$2" ;;
                --identity) IDENTITY="$2" ;;
                --dest) DEST="$2" ;;
            esac
            shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 1 ;;
    esac
done

if [[ -z "$VERSION" ]]; then
    # A daily driver names the release it descends from: "0.1.0+7" is seven commits
    # past v0.1.0. The bare "-dev" this replaced was identical on every build
    # between two releases, so a dogfood bug report couldn't name one.
    # Match only vX.Y.Z: an unfiltered describe would hand a checkpoint or vendor
    # tag to the stamp and the footer would read "vcheckpoint+3".
    LAST_TAG="$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"
    if [[ -n "$LAST_TAG" ]]; then
        AHEAD="$(git rev-list --count "${LAST_TAG}..HEAD" 2>/dev/null || echo 0)"
        VERSION="${LAST_TAG#v}+${AHEAD}"
    else
        VERSION="0.0.0+$(git rev-list --count HEAD 2>/dev/null || echo 0)"
    fi
fi
# Monotonic build number (commit count on the current branch): unique per release
# commit and Sparkle-compatible, unlike a short SHA. Deliberately NOT the "+N"
# above, which resets to 0 at every tag and so would go backwards for Sparkle.
BUILD="$(git rev-list --count HEAD 2>/dev/null || echo 0)"

APP="$DEST/ZenTerm.app"
BIN=".build/release/ZenTerm"

# SwiftPM resource bundles (brand SVGs, ghostty runtime resources). Bundle.module
# resolves them via Bundle.main.resourceURL, so they must ride along in the .app —
# a bare executable copy would fatalError on first Bundle.module access.
#
# A `*.bundle` glob over .build/release once signed, notarized and published a dead
# SwiftTerm bundle to users in v0.1.0, long after libghostty became the sole backend
# (ZEN-168): `swift build` never prunes .build, so a dropped dependency leaves its
# bundle there forever and the glob swept it into the app. Clearing the bundles
# first is what makes that impossible rather than merely detected — the build
# re-emits exactly the set Package.swift declares, so the app follows the manifest
# instead of whatever this machine happens to have built. Cheap: re-emitting a
# bundle is a resource copy, not a relink.
EXPECTED_BUNDLES=(ZenTerm_TerminalKit.bundle ZenTerm_ZenTerm.bundle)

echo "▸ Building release…"
rm -rf .build/release/*.bundle
swift build -c release

# The bundle set is asserted both ways, before anything is written to $APP. After
# the wipe these describe the manifest, not residue: a missing bundle means the
# build didn't emit one we ship, and an unexpected bundle means Package.swift grew
# one nobody told this script about. Both are worth stopping for, and both must
# stop *before* the rm -rf below — $APP defaults to the installed daily driver, and
# exiting after it would leave an unsigned, Info.plist-less shell in its place.
for bundle in "${EXPECTED_BUNDLES[@]}"; do
    [[ -d ".build/release/$bundle" ]] || {
        echo "✗ expected resource bundle missing: .build/release/$bundle" >&2
        echo "  a partial app would fatalError on first Bundle.module access" >&2
        exit 1
    }
done

for path in .build/release/*.bundle; do
    found="$(basename "$path")"
    for expected in "${EXPECTED_BUNDLES[@]}"; do
        [[ "$found" == "$expected" ]] && continue 2
    done
    echo "✗ Package.swift emits a resource bundle this script doesn't ship: $found" >&2
    echo "  add it to EXPECTED_BUNDLES" >&2
    exit 1
done

echo "▸ Assembling $APP"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN" "$APP/Contents/MacOS/ZenTerm"
cp icon/AppIcon.icns "$APP/Contents/Resources/AppIcon.icns"

for bundle in "${EXPECTED_BUNDLES[@]}"; do
    cp -R ".build/release/$bundle" "$APP/Contents/Resources/"
done

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>ZenTerm</string>
  <key>CFBundleDisplayName</key><string>ZenTerm</string>
  <key>CFBundleExecutable</key><string>ZenTerm</string>
  <key>CFBundleIdentifier</key><string>com.drucial.ZenTerm</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleIconName</key><string>AppIcon</string>
  <key>CFBundleShortVersionString</key><string>${VERSION}</string>
  <key>CFBundleVersion</key><string>${BUILD}</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
</dict>
</plist>
PLIST

# No --deep and no nested-code signing: GhosttyKit is a static library linked
# into the executable, and the SwiftPM .bundles are code-free resources sealed
# by the outer signature.
if [[ "$IDENTITY" == "-" ]]; then
    echo "▸ Ad-hoc signing"
    codesign --force --sign - "$APP"
else
    echo "▸ Signing with hardened runtime: $IDENTITY"
    codesign --force --options runtime --timestamp --sign "$IDENTITY" "$APP"
fi

echo "✓ $APP  (v${VERSION} build ${BUILD})"
