#!/usr/bin/env bash
# Records which ghostty pin, patches and build script the staged GhosttyKit was built from, and refuses a stale one.
# Usage: bin/ghosttykit-stamp write | verify
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
XCFRAMEWORK="$ROOT/Frameworks/GhosttyKit.xcframework"
RESOURCES="$ROOT/Sources/TerminalKit/Resources/ghostty-resources"
# Inside the xcframework so a worktree's symlink and CI's artifact cache carry it along.
STAMP="$XCFRAMEWORK/zenterm-build-inputs"

# The same inputs as CI's GhosttyKit cache key.
fingerprint() {
    local pin
    pin="$(git rev-parse HEAD:vendor/ghostty)"
    shopt -s nullglob
    local inputs=("bin/build-ghosttykit" patches/ghostty-*.patch)
    shopt -u nullglob
    local digest
    digest="$(for f in "${inputs[@]}"; do printf '%s\n' "$f"; cat "$f"; done | shasum -a 256 | cut -d' ' -f1)"
    printf 'ghostty %s\ninputs %s\n' "$pin" "$digest"
}

verify() {
    if [[ ! -d "$XCFRAMEWORK" || ! -d "$RESOURCES" ]]; then
        echo "✗ GhosttyKit artifacts missing: build them first with bin/build-ghosttykit" >&2
        exit 1
    fi
    if [[ ! -f "$STAMP" ]] || [[ "$(cat "$STAMP")" != "$(fingerprint)" ]]; then
        echo "✗ GhosttyKit is stale: the ghostty pin, a patch in patches/, or bin/build-ghosttykit changed since it was built" >&2
        echo "  rebuild it with bin/build-ghosttykit" >&2
        exit 1
    fi
}

case "${1:-}" in
    write) fingerprint > "$STAMP" ;;
    verify) verify ;;
    *) echo "usage: bin/ghosttykit-stamp write | verify" >&2; exit 2 ;;
esac
