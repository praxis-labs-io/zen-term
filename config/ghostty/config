# zen-term libghostty spike (ZEN-40) config.
#
# Loaded explicitly by GhosttyApp for the .ghostty backend — this does NOT touch
# your real ~/.config/ghostty. Rosé Pine Moon palette on the darker #191724 base
# (matching zen-term's own theme) and JetBrainsMono Nerd Font.
#
# A GPU cursor-trail shader was explored and removed: any custom shader routes
# ghostty through an intermediate-texture pass that flashes white on TUI transitions
# in this transparent-window embed. Revisit under ZEN-45. Native smooth scroll and
# shell integration still apply.

theme = Rose Pine Moon
background = #191724

font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-thicken = true

cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
