+/// A program's status report (OSC 7501).
+pub const ProgramStatus = struct {
+    state: terminal.osc.Command.ProgramStatus.State,
+    kind: ?terminal.osc.Command.ProgramStatus.Kind,
+    app: [:0]const u8,
+    msg: [:0]const u8,
+    title: [:0]const u8,
+
+    /// The C kind: `terminal.osc.Command.ProgramStatus.Kind` with `none`
+    /// first, because C has no optional enums.
+    pub const Kind = enum(c_int) {
+        none,
+        permission,
+        question,
+        auth,
+    };
+
+    // Sync with: ghostty_action_program_status_s
+    pub const C = extern struct {
+        state: c_int,
+        kind: Kind,
+        app: [*:0]const u8,
+        msg: [*:0]const u8,
+        title: [*:0]const u8,
+    };
+
+    pub fn cval(self: ProgramStatus) C {
+        return .{
+            .state = @intFromEnum(self.state),
+            .kind = if (self.kind) |kind| switch (kind) {
