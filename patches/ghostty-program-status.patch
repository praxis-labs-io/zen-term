+
+    /// Answer an OSC 7501 support query, or hand the program's own status
+    /// report to the surface. Reports about a sub-record (`id=`) are
+    /// dropped: the surface tracks the program itself.
+    fn programStatus(
+        self: *StreamHandler,
+        cmd: terminal.osc.Command.ProgramStatus,
+    ) !void {
+        const report = switch (cmd) {
+            .query => |terminator| {
+                const reply = "\x1b]7501;" ++ terminal.osc.program_status.query_reply;
+                var buf: [reply.len + 2]u8 = undefined;
+                const out = try std.fmt.bufPrint(&buf, "{s}{s}", .{ reply, terminator.string() });
+                self.messageWriter(try termio.Message.writeReq(self.alloc, out));
+                return;
+            },
+            .report => |report| report,
+        };
+        if (report.readOption(.id) != null) return;
+
+        var message = apprt.surface.Message{ .program_status = .{
+            .state = report.state,
+            .kind = report.readOption(.kind),
+            .app = undefined,
+            .msg = undefined,
+            .title = undefined,
+        } };
+        const dest = &message.program_status;
+
+        const app = report.readOption(.app) orelse "";
+        const app_len = @min(app.len, dest.app.len);
+        @memcpy(dest.app[0..app_len], app[0..app_len]);
+        dest.app[app_len] = 0;
+
+        dest.msg[copyStatusText(report, .msg, &dest.msg)] = 0;
+        dest.title[copyStatusText(report, .title, &dest.title)] = 0;
+        self.surfaceMessageWriter(message);
+    }
+
+    /// Copy the decoded `title` or `msg` into `dest`, cut at a UTF-8
+    /// boundary to fit, and return its length.
+    fn copyStatusText(
+        report: terminal.osc.Command.ProgramStatus.Report,
+        comptime option: terminal.osc.Command.ProgramStatus.Option,
+        dest: []u8,
+    ) usize {
+        var buf: [terminal.osc.program_status.max_msg_bytes]u8 = undefined;
+        var writer: std.Io.Writer = .fixed(&buf);
+        report.writeText(option, &writer) catch unreachable;
+        const text = writer.buffered();
+
+        var cut = @min(text.len, dest.len);
+        if (cut < text.len) {
+            while (cut > 0 and (text[cut] & 0xC0) == 0x80) cut -= 1;
+        }
+        @memcpy(dest[0..cut], text[0..cut]);
+        return cut;
+    }
 };
 
