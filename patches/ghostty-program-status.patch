@@ -1548,4 +1549,59 @@ pub const StreamHandler = struct {
     fn progressReport(self: *StreamHandler, report: terminal.osc.Command.ProgressReport) void {
         self.surfaceMessageWriter(.{ .progress_report = report });
     }
+
+    /// Answer an OSC 7501 support query, or hand the program's own status
+    /// report to the surface. Reports about a sub-record (`id=`) are
+    /// dropped: the surface tracks the program itself.
+    fn programStatus(
+        self: *StreamHandler,
+        status: terminal.osc.Command.ProgramStatus,
+    ) !void {
+        if (status.query) |terminator| {
+            const reply = "\x1b]7501;" ++ terminal.osc.program_status.query_reply;
+            var buf: [reply.len + 2]u8 = undefined;
+            const out = try std.fmt.bufPrint(&buf, "{s}{s}", .{ reply, terminator.string() });
+            self.messageWriter(try termio.Message.writeReq(self.alloc, out));
+            return;
+        }
+        if (status.has_id) return;
+
+        var message = apprt.surface.Message{ .program_status = .{
+            .state = status.state,
+            .kind = status.kind,
+            .app = undefined,
+            .msg = undefined,
+            .title = undefined,
+        } };
+        const dest = &message.program_status;
+
+        const app_len = @min(status.app.len, dest.app.len);
+        @memcpy(dest.app[0..app_len], status.app[0..app_len]);
+        dest.app[app_len] = 0;
+
+        dest.msg[decodeStatusText(status.msg, &dest.msg)] = 0;
+        dest.title[decodeStatusText(status.title, &dest.title)] = 0;
+        self.surfaceMessageWriter(message);
+    }
+
+    /// Decode base64 into `dest`, cut at a UTF-8 boundary to fit, and
+    /// return its length. Text that doesn't decode reads as empty.
+    fn decodeStatusText(encoded: []const u8, dest: []u8) usize {
+        if (encoded.len == 0) return 0;
+        const decoder = if (std.mem.endsWith(u8, encoded, "="))
+            std.base64.standard.Decoder
+        else
+            std.base64.standard_no_pad.Decoder;
+        var buf: [4096]u8 = undefined;
+        const len = decoder.calcSizeForSlice(encoded) catch return 0;
+        if (len > buf.len) return 0;
+        decoder.decode(buf[0..len], encoded) catch return 0;
+
+        var cut = @min(len, dest.len);
+        if (cut < len) {
+            while (cut > 0 and (buf[cut] & 0xC0) == 0x80) cut -= 1;
+        }
+        @memcpy(dest[0..cut], buf[0..cut]);
+        return cut;
+    }
 };
