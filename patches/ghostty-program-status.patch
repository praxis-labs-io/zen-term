diff --git i/src/terminal/osc/parsers/program_status.zig w/src/terminal/osc/parsers/program_status.zig
new file mode 100644
index 000000000..b4f5654b1
--- /dev/null
+++ w/src/terminal/osc/parsers/program_status.zig
@@ -0,0 +1,130 @@
+//! OSC 7501: Program Status Protocol
+//!
+//! A program tells the terminal what it is doing with a list of
+//! `key=value` pairs separated by colons:
+//!
+//! ```
+//! ESC ] 7501 ; state=blocked:app=claude-code:kind=permission:msg=<base64> ESC \
+//! ```
+//!
+//! A program asks whether the terminal supports the protocol by sending
+//! `?` as the body. A terminal that does answers with `query_reply`.
+const std = @import("std");
+
+const osc = @import("../../osc.zig");
+const Parser = osc.Parser;
+const Command = osc.Command;
+
+/// The body of the reply to a support query.
+pub const query_reply = "?:states=idle,working,done,blocked,error:kinds=permission,question,auth";
+
+/// Parse OSC 7501. Unknown keys and malformed pairs are skipped; a report
+/// without a known `state` is discarded.
+pub fn parse(parser: *Parser, terminator_ch: ?u8) ?*Command {
+    const writer = parser.writer orelse {
+        parser.state = .invalid;
+        return null;
+    };
+    const data = writer.buffered();
+
+    if (std.mem.eql(u8, data, "?")) {
+        parser.command = .{ .program_status = .{ .query = .init(terminator_ch) } };
+        return &parser.command;
+    }
+
+    var state: ?Command.ProgramStatus.State = null;
+    var kind: Command.ProgramStatus.Kind = .none;
+    var app: []const u8 = "";
+    var msg: []const u8 = "";
+    var title: []const u8 = "";
+    var has_id = false;
+
+    var pairs = std.mem.splitScalar(u8, data, ':');
+    while (pairs.next()) |pair| {
+        const eq = std.mem.indexOfScalar(u8, pair, '=') orelse continue;
+        const key = pair[0..eq];
+        const value = pair[eq + 1 ..];
+        if (std.mem.eql(u8, key, "state")) {
+            state = std.meta.stringToEnum(Command.ProgramStatus.State, value);
+        } else if (std.mem.eql(u8, key, "kind")) {
+            kind = std.meta.stringToEnum(Command.ProgramStatus.Kind, value) orelse .none;
+        } else if (std.mem.eql(u8, key, "app")) {
+            app = value;
+        } else if (std.mem.eql(u8, key, "msg")) {
+            msg = value;
+        } else if (std.mem.eql(u8, key, "title")) {
+            title = value;
+        } else if (std.mem.eql(u8, key, "id")) {
+            has_id = value.len > 0;
+        }
+    }
+
+    const reported = state orelse {
+        parser.state = .invalid;
+        return null;
+    };
+
+    parser.command = .{ .program_status = .{
+        .state = reported,
+        .kind = if (reported == .blocked) kind else .none,
+        .app = app,
+        .msg = msg,
+        .title = title,
+        .has_id = has_id,
+    } };
+    return &parser.command;
+}
+
+test "OSC 7501: query" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+    for ("7501;?") |ch| p.next(ch);
+
+    const cmd = p.end(0x07).?.*;
+    try testing.expect(cmd == .program_status);
+    try testing.expectEqual(osc.Terminator.bel, cmd.program_status.query.?);
+}
+
+test "OSC 7501: blocked report" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+    for ("7501;state=blocked:app=claude-code:kind=permission:msg=aGk=:title=cmV2aWV3") |ch| p.next(ch);
+
+    const cmd = p.end('\x1b').?.*;
+    try testing.expect(cmd == .program_status);
+    const v = cmd.program_status;
+    try testing.expect(v.query == null);
+    try testing.expectEqual(.blocked, v.state);
+    try testing.expectEqual(.permission, v.kind);
+    try testing.expectEqualStrings("claude-code", v.app);
+    try testing.expectEqualStrings("aGk=", v.msg);
+    try testing.expectEqualStrings("cmV2aWV3", v.title);
+    try testing.expect(!v.has_id);
+}
+
+test "OSC 7501: kind is read only while blocked" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+    for ("7501;state=working:kind=question:id=task") |ch| p.next(ch);
+
+    const v = p.end('\x1b').?.program_status;
+    try testing.expectEqual(.working, v.state);
+    try testing.expectEqual(.none, v.kind);
+    try testing.expect(v.has_id);
+}
+
+test "OSC 7501: unknown state is discarded" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+    for ("7501;state=sleeping") |ch| p.next(ch);
+
+    try testing.expect(p.end('\x1b') == null);
+}
