+    /// Tracks the cell at `point` on the active screen. Null if the point is
+    /// outside the screen. Free it with ghostty_surface_mark_free.
+    export fn ghostty_surface_mark_new(surface: *Surface, point: Point) ?*Mark {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        const screens = &core_surface.io.terminal.screens;
+        const p = point.pin(screens.active) orelse return null;
+        const mark = global.alloc().create(Mark) catch return null;
+        const tracked = screens.active.pages.trackPin(p) catch {
+            global.alloc().destroy(mark);
+            return null;
+        };
+        mark.* = .{
+            .key = screens.active_key,
+            .generation = screens.generation(screens.active_key),
+            .pin = tracked,
+        };
