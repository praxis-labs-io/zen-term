+                .text_len = @intCast(offset - start),
+                .width = switch (cell.wide) {
+                    .narrow, .spacer_head => 1,
+                    .wide => 2,
+                    .spacer_tail => 0,
+                },
+                .content = @intFromEnum(cell.semantic_content),
+            };
+        }
