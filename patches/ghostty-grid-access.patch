+        const screen = core_surface.io.terminal.screens.active;
+        const p = screen.pages.pin(.{ .screen = .{ .y = y } }) orelse return false;
+        const rac = p.rowAndCell();
+        const cells = p.cells(.all);
+
+        var text_len: usize = 0;
+        for (cells) |*cell| {
+            if (!cell.hasText()) continue;
+            text_len += std.unicode.utf8CodepointSequenceLength(cell.codepoint()) catch 0;
+            if (cell.hasGrapheme()) if (p.grapheme(cell)) |cps| for (cps) |cp| {
+                text_len += std.unicode.utf8CodepointSequenceLength(cp) catch 0;
+            };
+        }
