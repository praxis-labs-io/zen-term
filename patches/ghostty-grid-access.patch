+        result.* = .{
+            .cells = out_cells.ptr,
+            .cells_len = out_cells.len,
+            .text = text.ptr,
+            .text_len = text.len,
+            .wrap = rac.row.wrap,
+            .wrap_continuation = rac.row.wrap_continuation,
+            .prompt = @intFromEnum(rac.row.semantic_prompt),
+        };
+        return true;
+    }
