+/// The screen point of a search match's start, or null once its rows are gone.
+/// Locks the renderer mutex: the search thread notifies without it.
+fn searchMatchStart(self: *Surface, start: terminal.Pin) ?terminal.point.Coordinate {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const pages = &self.io.terminal.screens.active.pages;
+    const pt = pages.pointFromPin(.screen, start) orelse return null;
+    if (start.y >= start.node.rows()) return null;
+    return pt.screen;
+}
